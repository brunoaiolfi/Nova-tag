{
  "name": "NovaTag",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "lint": "eslint .",
    "start": "expo start --dev-client",
    "test": "jest",
    "test:auth:api": "node scripts/verify-auth-api.cjs",
    "test:orders:api": "node scripts/verify-orders-api.cjs",
    "nfc:profile": "node scripts/nfc-profile.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "check": "expo install --check",
    "source:manifest": "node scripts/source-manifest.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "^7.3.14",
    "expo": "57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nfc-manager": "4.0.0-beta.10",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js"
}
