{
  "expo": {
    "name": "Nova-tag NFC",
    "slug": "nova-tag-nfc",
    "scheme": "novatag",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    },
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joaoaugustopf.novatag.nfc",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Conectar à API e ao Metro do laboratório na rede Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.joaoaugustopf.novatag.nfc",
      "permissions": ["android.permission.NFC"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ler e configurar etiquetas NFC para rastrear pedidos do laboratório.",
          "includeNdefEntitlement": false,
          "selectIdentifiers": ["D2760000850101"]
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "73b4f68c-39fb-4a91-84de-f01ac5280de1"
      }
    },
    "owner": "joaoaugustopfpf"
  }
}
